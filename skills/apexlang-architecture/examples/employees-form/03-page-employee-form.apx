page 41 (
    name: Employee
    alias: EMPLOYEE-FORM
    title: Employee
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    help {
        helpText: Create or update one employee. Full name, email and an active sector are required; the email must be unique.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/breadcrumb
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region form-employee (
        name: Employee
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region basic-data (
        name: Basic data
        type: staticContent
        source {
            htmlCode: <p>Identification and contact.</p>
        }
        layout {
            sequence: 10
            parentRegion: @form-employee
            slot: regionBody
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h2
            ]
            renderComponents: belowContent
        }
    )

    region organization (
        name: Organization
        type: staticContent
        source {
            htmlCode: <p>Where the employee belongs.</p>
        }
        layout {
            sequence: 20
            parentRegion: @form-employee
            slot: regionBody
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h2
            ]
            renderComponents: belowContent
        }
    )

    region form-buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P41_EMPLOYEE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @basic-data
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P41_FULL_NAME (
        type: textField
        label {
            label: Full name
            alignment: left
        }
        layout {
            sequence: 20
            region: @basic-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 120
        }
        help {
            inlineHelpText: Legal name as on the ID document.
        }
    )

    pageItem P41_EMAIL (
        type: textField
        label {
            label: Email
            alignment: left
        }
        settings {
            subtype: email
        }
        layout {
            sequence: 30
            region: @basic-data
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
            maxLength: 150
        }
        help {
            inlineHelpText: Work address; must be unique.
            helpText: The email identifies the employee across the application, so it cannot repeat. The package rejects a duplicate with a friendly message and a unique index backs it up.
        }
    )

    pageItem P41_SECTOR_ID (
        type: selectList
        label {
            label: Sector
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select name  as d,
                       sector_id as r
                  from hr_sectors
                 where active_flag = 'Y'
                 order by name
                ```
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @organization
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            inlineHelpText: Only active sectors are listed.
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 20
            region: @form-buttons
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P41_EMPLOYEE_ID
        }
    )

    button apply-changes (
        buttonName: APPLY-CHANGES
        label: Apply Changes
        layout {
            sequence: 30
            region: @form-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_EMPLOYEE_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 10
            region: @form-buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Deactivate this employee?
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P41_EMPLOYEE_ID
        }
    )

    process load-employee (
        name: Load employee
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    -- Read side: plain inline SQL (back-end-conventions.md section 5).
                    -- Nothing to load in create mode.
                    if :P41_EMPLOYEE_ID is not null then
                        select full_name, email, sector_id
                          into :P41_FULL_NAME, :P41_EMAIL, :P41_SECTOR_ID
                          from hr_employees
                         where employee_id = :P41_EMPLOYEE_ID;
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process create-employee (
        name: Create employee
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_employee_id number;
                begin
                    -- The package validates and writes; this process only orchestrates.
                    pkg_employees.create_row(
                        p_full_name   => :P41_FULL_NAME,
                        p_email       => :P41_EMAIL,
                        p_sector_id   => :P41_SECTOR_ID,
                        p_employee_id => l_employee_id
                    );
                    -- Carry the generated PK back so the page continues in edit mode.
                    :P41_EMPLOYEE_ID := l_employee_id;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Employee created.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE
        }
    )

    process update-employee (
        name: Update employee
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    pkg_employees.update_row(
                        p_employee_id => :P41_EMPLOYEE_ID,
                        p_full_name   => :P41_FULL_NAME,
                        p_email       => :P41_EMAIL,
                        p_sector_id   => :P41_SECTOR_ID
                    );
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Employee updated.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: APPLY-CHANGES
        }
    )

    process delete-employee (
        name: Deactivate employee
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    -- Soft delete: the package inactivates, it does not DELETE.
                    pkg_employees.delete_row(p_employee_id => :P41_EMPLOYEE_ID);
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Employee deactivated.
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE
        }
    )

)
