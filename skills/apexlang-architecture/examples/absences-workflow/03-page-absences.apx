page 60 (
    name: Absence requests
    alias: ABSENCE-REQUESTS
    title: Absence requests
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/breadcrumb
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region requests (
        name: Requests
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                -- data only: no markup is projected here. The status badge is
                -- rendered by the STATUS column's columnFormatting.htmlExpression,
                -- which maps STATUS_CSS verbatim: one of Universal Theme's six
                -- semantic classes, every value a literal, the ELSE closing the set.
                select absence_id,
                       employee_no,
                       absence_type,
                       to_char(date_from, 'DD/MM/YYYY') as date_from,
                       to_char(date_to, 'DD/MM/YYYY') as date_to,
                       status,
                       case status
                            when 'APPROVED' then 'u-success'
                            when 'REJECTED' then 'u-danger'
                            else 'u-warning'
                       end as status_css
                  from hr_absences
                 where cancelled_at is null
                 order by date_from desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }

        column ABSENCE_ID (
            type: link
            heading {
                heading: Resolve
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            link {
                target: {
                    page: 62
                    items: {
                        P62_ABSENCE_ID: #ABSENCE_ID#
                    }
                    clearCache: 62
                }
                linkText: <span aria-hidden="true" class="fa fa-gavel"></span><span class="u-VisuallyHidden">Resolve request #ABSENCE_ID#</span>
            }
        )

        column EMPLOYEE_NO (
            type: plainText
            heading {
                heading: Employee
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ABSENCE_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column DATE_FROM (
            type: plainText
            heading {
                heading: From
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column DATE_TO (
            type: plainText
            heading {
                heading: To
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            columnFormatting {
                htmlExpression: <span class="t-Badge #STATUS_CSS#">#STATUS#</span>
            }
        )

        column STATUS_CSS (
            type: hidden
            heading {
                heading: Status CSS
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )
    )

    dynamicAction refresh-requests (
        name: Refresh IR after modal closes
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @requests
        }

        action refresh-ir (
            action: refresh
            affectedElements {
                selectionType: region
                region: @requests
            }
            execution {
                sequence: 10
            }
        )

    )

)
