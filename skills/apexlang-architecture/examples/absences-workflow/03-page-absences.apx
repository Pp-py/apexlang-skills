page 60 (
    name: Absence requests
    alias: ABSENCE-REQUESTS
    title: Absence requests
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region requests (
        name: Requests
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select absence_id,
                       employee_no,
                       absence_type,
                       to_char(date_from, 'DD/MM/YYYY') as date_from,
                       to_char(date_to, 'DD/MM/YYYY') as date_to,
                       -- badge built in SQL; the column renders it with !RAW
                       case status
                            when 'APPROVED' then '<span class="u-color-9-text"><b>Approved</b></span>'
                            when 'REJECTED' then '<span class="u-color-7-text"><b>Rejected</b></span>'
                            else '<span class="u-color-15-text"><b>Requested</b></span>'
                       end as status_bdg
                  from hr_absences
                 where cancelled_at is null
                 order by date_from desc
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 62
                items: {
                    P62_ABSENCE_ID: #ABSENCE_ID#
                }
                clearCache: 62
            }
            linkIcon: <span aria-hidden="true" class="fa fa-gavel" title="Resolve"></span>
        }

        column ABSENCE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column EMPLOYEE_NO (
            type: plainText
            heading {
                heading: Employee
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column ABSENCE_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column DATE_FROM (
            type: plainText
            heading {
                heading: From
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column DATE_TO (
            type: plainText
            heading {
                heading: To
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column STATUS_BDG (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            columnFormatting {
                htmlExpression: #STATUS_BDG!RAW#
            }
        )
    )

    dynamicAction refresh-requests (
        name: Refresh IR after modal closes
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @requests
        }

        action refresh-ir (
            action: refresh
            affectedElements {
                selectionType: region
                region: @requests
            }
            execution {
                sequence: 10
            }
        )

    )

)

page 62 (
    name: Resolve absence
    alias: ABSENCE-RESOLVE
    title: Resolve absence
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }

    region form-resolve (
        name: Resolve request
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P62_ABSENCE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-resolve
            slot: regionBody
        }
    )

    pageItem P62_REASON (
        type: textField
        label {
            label: Reason (required to reject)
        }
        layout {
            sequence: 20
            region: @form-resolve
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        validation {
            maxLength: 400
        }
    )

    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 10
            region: @form-resolve
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 20
            region: @form-resolve
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    validation reject-reason-required (
        name: Reason required when rejecting
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P62_REASON
        }
        error {
            errorMessage: Enter the rejection reason.
            associatedItem: @P62_REASON
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'REJECT'
        }
    )

    process approve-absence (
        name: Approve absence
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    -- transition as a package verb: from-state guard,
                    -- approved_by/approved_at stamp and side effects, all in pkg_absences
                    pkg_absences.approve(
                        p_absence_id => :P62_ABSENCE_ID,
                        p_approver   => :APP_USER
                    );
                end;
                ```
        }
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'APPROVE'
        }
    )

    process reject-absence (
        name: Reject absence
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    pkg_absences.reject(
                        p_absence_id => :P62_ABSENCE_ID,
                        p_reason     => :P62_REASON
                    );
                end;
                ```
        }
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'REJECT'
        }
    )

    process close-dialog (
        name: Close dialog and refresh p60
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('APPROVE','REJECT')
        }
    )

)
