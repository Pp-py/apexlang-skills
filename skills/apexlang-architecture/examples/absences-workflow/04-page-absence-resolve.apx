page 62 (
    name: Resolve absence
    alias: ABSENCE-RESOLVE
    title: Resolve absence
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: mustNotBePublicUser
        pageAccessProtection: argumentsMustHaveChecksum
    }

    region form-resolve (
        name: Resolve request
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P62_ABSENCE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @form-resolve
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P62_REASON (
        type: textField
        label {
            label: Reason (required to reject)
        }
        layout {
            sequence: 20
            region: @form-resolve
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional
            templateOptions: #DEFAULT#
        }
        help {
            inlineHelpText: Required when rejecting; stored with the request and shown to the requester.
        }
        validation {
            maxLength: 400
        }
    )

    button approve (
        buttonName: APPROVE
        label: Approve
        layout {
            sequence: 10
            region: @form-resolve
            slot: create
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button reject (
        buttonName: REJECT
        label: Reject
        layout {
            sequence: 20
            region: @form-resolve
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Reject this absence request? The decision cannot be undone.
            style: danger
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    validation VAL_REJECT_REASON (
        name: Reason required when rejecting
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P62_REASON
        }
        error {
            errorMessage: Enter the rejection reason.
            associatedItem: @P62_REASON
        }
        serverSideCondition {
            whenButtonPressed: @reject
        }
    )

    process approve-absence (
        name: Approve absence
        type: invokeApi
        invoke {
            package: pkg_absences
            procedureOrFunction: approve
        }
        parameter p_absence_id (
            parameter {
                direction: in
                dataType: number
            }
            value {
                type: item
                item: P62_ABSENCE_ID
            }
            advanced {
                displaySequence: 1
            }
        )
        parameter p_approver (
            parameter {
                direction: in
                dataType: varchar2
            }
            value {
                type: expression
                plsqlExpression: :APP_USER
            }
            advanced {
                displaySequence: 2
            }
        )
        execution {
            sequence: 10
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'APPROVE'
        }
    )

    process reject-absence (
        name: Reject absence
        type: invokeApi
        invoke {
            package: pkg_absences
            procedureOrFunction: reject
        }
        parameter p_absence_id (
            parameter {
                direction: in
                dataType: number
            }
            value {
                type: item
                item: P62_ABSENCE_ID
            }
            advanced {
                displaySequence: 1
            }
        )
        parameter p_reason (
            parameter {
                direction: in
                dataType: varchar2
            }
            value {
                type: item
                item: P62_REASON
            }
            advanced {
                displaySequence: 2
            }
        )
        execution {
            sequence: 20
            point: afterSubmit
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST = 'REJECT'
        }
        security {
            authorizationScheme: @administration-rights
        }
    )

    process close-dialog (
        name: Close dialog and refresh p60
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :REQUEST in ('APPROVE','REJECT')
        }
    )

)
