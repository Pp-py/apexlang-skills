    process save-sectors (
        name: Save sectors
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    -- thin wrapper: a grid save
                    apex_error.add_error(p_message => 'x', p_display_location => apex_error.c_inline_in_notification);
                    l_tab.extend(1);
                    pkg_sectors.save_row(
                        p_row_status => :APEX$ROW_STATUS,
                        p_code       => :CODE
                    );
                end;
                ```
        }
    )
)
