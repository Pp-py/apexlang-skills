{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pp-py.github.io/apexlang-skills/schemas/1/ui-result.schema.json",
  "title": "ui-result (EXPERIMENTAL, schemaVersion 1)",
  "description": "One apex-ux run on one app: the static scan over .apx files (scope static, ux-scan.py) or the runtime checks on one page (scope runtime, ux-check.py), per FAIL criterion of skills/apex-ux/criteria/. Written by the tool (method: tool) to stdout and, with --task, to <evidenceDir>/<task>/ui-<alias>-static.json or ui-<alias>-runtime-<page>.json; axe-core's full output under <evidenceDir>/<task>/raw/ui-<alias>/, cited with its sha256. Advisories never change the status. A PASS is never 'WCAG compliant': it covers the FAIL criteria this run exercised, nothing else.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "status", "reasons", "context", "scope", "criteria", "advisories"],
  "properties": {
    "kind": { "const": "ui-result" },
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN"] },
    "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/reason" } },
    "app": { "$ref": "common.schema.json#/$defs/appRef" },
    "context": { "$ref": "common.schema.json#/$defs/context" },
    "scope": { "description": "static = ux-scan.py over .apx files; runtime = ux-check.py on the page pw.sh holds.", "enum": ["static", "runtime"] },
    "files": { "description": "static: the .apx files scanned.", "type": "array", "items": { "$ref": "common.schema.json#/$defs/relPath" } },
    "unparsed": {
      "description": "static: files the parser could not follow — their item and button checks did not run.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "detail"],
        "properties": { "path": { "$ref": "common.schema.json#/$defs/relPath" }, "detail": { "$ref": "common.schema.json#/$defs/safeText" } }
      }
    },
    "engine": {
      "description": "runtime: the accessibility engine, as verified against its lock before it ran.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "const": "axe-core" },
        "version": { "$ref": "common.schema.json#/$defs/toolVersion" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "criteria": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
    "advisories": {
      "description": "ADVISE signals (UX-AXE-MINOR, UX-AXE-REVIEW, UX-ORACLE-OWNED): reported, never a verdict.",
      "type": "array",
      "items": { "allOf": [{ "$ref": "#/$defs/finding" }, { "required": ["id"] }] }
    },
    "errors": {
      "description": "runtime: frames axe could not run in (cross-origin, navigated away).",
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidenceRef" } }
  },
  "allOf": [
    {
      "description": "PASS: at least one criterion was exercised and held",
      "if": { "properties": { "status": { "const": "PASS" } } },
      "then": { "properties": { "criteria": { "contains": { "properties": { "status": { "const": "PASS" } } } } } }
    },
    {
      "description": "a FAIL criterion makes the run FAIL",
      "if": { "properties": { "criteria": { "contains": { "properties": { "status": { "const": "FAIL" } } } } } },
      "then": { "properties": { "status": { "const": "FAIL" } } }
    },
    {
      "description": "a static PASS scanned files and parsed every one",
      "if": { "properties": { "scope": { "const": "static" }, "status": { "const": "PASS" } } },
      "then": { "required": ["files"], "properties": { "files": { "minItems": 1 }, "unparsed": { "maxItems": 0 } } }
    },
    {
      "description": "a runtime verdict names the verified engine and the page it ran on",
      "if": { "properties": { "scope": { "const": "runtime" }, "status": { "enum": ["PASS", "FAIL"] } } },
      "then": {
        "required": ["engine"],
        "properties": { "context": { "required": ["target"], "properties": { "target": { "required": ["runtimeUrl"] } } } }
      }
    }
  ],
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "findings"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/criterionId" },
        "status": { "description": "NOT_RUN: this run did not exercise it (no --dialog, an opener not found).", "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "notApplicableReason": { "$ref": "common.schema.json#/$defs/safeText" }
      },
      "allOf": [
        {
          "description": "a criterion not exercised says why",
          "if": { "properties": { "status": { "const": "NOT_RUN" } } },
          "then": { "required": ["notApplicableReason"] }
        },
        {
          "description": "a FAIL names what failed; a PASS has nothing against it",
          "if": { "properties": { "status": { "const": "FAIL" } } },
          "then": { "properties": { "findings": { "minItems": 1 } } },
          "else": { "properties": { "findings": { "maxItems": 0 } } }
        }
      ]
    },
    "finding": {
      "description": "static: path, line, detail. runtime: axe's rule, impact, where (page or the dialog opened), frame, node count, CSS targets and help URL — never the node's HTML; a dialog: its selector and the sub-checks that failed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/criterionId" },
        "path": { "$ref": "common.schema.json#/$defs/relPath" },
        "line": { "type": "integer", "minimum": 1 },
        "detail": { "$ref": "common.schema.json#/$defs/safeText" },
        "rule": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "impact": { "enum": ["minor", "moderate", "serious", "critical", null] },
        "where": { "$ref": "common.schema.json#/$defs/safeText" },
        "frame": { "$ref": "common.schema.json#/$defs/safeText" },
        "count": { "type": "integer", "minimum": 0 },
        "targets": { "type": "array", "maxItems": 10, "items": { "$ref": "common.schema.json#/$defs/safeText" } },
        "help": { "$ref": "common.schema.json#/$defs/safeText" },
        "selector": { "$ref": "common.schema.json#/$defs/safeText" },
        "failed": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["opened", "focusIn", "tabStays", "shiftTabStays", "escCloses", "focusReturns"] }
        },
        "error": { "$ref": "common.schema.json#/$defs/safeText" }
      }
    }
  }
}
